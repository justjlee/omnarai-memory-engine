{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnarai.org/schemas/proposals/expression-interpretation-1.0.schema.json",
  "title": "Expression Interpretation 1.0.Schema.Json",
  "description": "PROPOSAL, not a registered or deployed Omnarai contract. Versioned by the November 23 2026 handoff.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "primary_id",
    "primary_sha256",
    "interpretation",
    "method",
    "interpreter_declared",
    "limitations",
    "created_at"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "enum": [
        "expression-interpretation/1.0"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/#-]+$",
      "maxLength": 200
    },
    "primary_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/#-]+$",
      "maxLength": 200
    },
    "primary_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "interpretation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "method": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "interpreter_declared": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "maxItems": 30
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
