{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnarai.org/schemas/proposals/verifier-receipt-1.0.schema.json",
  "title": "Verifier Receipt v1.0",
  "description": "PROPOSAL, not a registered or deployed Omnarai contract. Versioned by the November 23 2026 handoff.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "source_sha256",
    "verifier_id",
    "independent",
    "result",
    "method_version"
  ],
  "properties": {
    "receipt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/#-]+$",
      "maxLength": 200
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verifier_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "independent": {
      "type": "boolean"
    },
    "result": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "inconclusive"
      ]
    },
    "method_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "cost": {
      "type": "number",
      "minimum": 0
    }
  }
}
