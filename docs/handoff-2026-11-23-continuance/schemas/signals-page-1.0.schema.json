{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnarai.org/schemas/proposals/signals-page-1.0.schema.json",
  "title": "signals-page-1.0",
  "description": "Proposed 2026-11-23 contract; not deployed; intended for repo-adapted validation.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "signals-page/1.0"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Change"
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "has_more": {
      "type": "boolean"
    }
  },
  "required": [
    "schema",
    "events",
    "next_cursor",
    "has_more"
  ],
  "$defs": {
    "Change": {
      "title": "Signals Change 1.0.Schema.Json",
      "description": "PROPOSAL, not a registered or deployed Omnarai contract. Versioned by the November 23 2026 handoff.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "event_id",
        "source_id",
        "source_revision",
        "kind",
        "occurred_at",
        "public_scope"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "enum": [
            "signals-change/1.0"
          ]
        },
        "event_id": {
          "type": "string",
          "pattern": "^sig_[0-9a-f]{32}$"
        },
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:/#-]+$",
          "maxLength": 200
        },
        "source_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "kind": {
          "type": "string",
          "enum": [
            "admitted",
            "claim_status_changed",
            "certification_changed",
            "work_progress",
            "retracted",
            "redacted",
            "published"
          ]
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "public_scope": {
          "type": "string",
          "enum": [
            "footprint",
            "claim",
            "divergence",
            "work",
            "voice"
          ]
        }
      }
    }
  }
}
