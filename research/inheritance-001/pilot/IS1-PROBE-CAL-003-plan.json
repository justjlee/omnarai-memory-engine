  "decision_rule": {
    "verification": [
      {
        "when": "every producer's verified share (records that pass their task's hidden checks, of its completed calls) >= 0.5",
        "then": "producers can leave verifiable work with these instructions: prepare Pilot 002 (fresh sealed draw, new registration, xz's approval)"
      },
      {
        "when": "any producer's verified share < 0.25",
        "then": "that producer cannot reliably leave verifiable work this way: xz decides (replace it, or change the instructions) before any new pilot"
      },
      {
        "when": "anything else",
        "then": "proceed only on xz's decision, given the expected number of verified records in a pilot (56 producer calls times the shares)"
      }
    ],
    "placebo": {
      "when": "no number-domain record verifies",
      "then": "arm E (the placebo) would be empty again: fix before any registration"
    },
    "size": {
      "when": "a producer has more than 10% of its completed replies set aside as too long",
      "then": "tighten the length request before any registration"
    },
    "output_cap": {
      "when": "for any producer, more than 10% of its completed calls stop at its output cap",
      "then": "raise that producer's cap by half and re-project before any registration"
    },
    "cap_enforcement": {
      "when": "any completed call bills more output than the requested cap, a DeepSeek call reports reasoning tokens, or an OpenAI call reports more reasoning tokens than completion tokens",
      "then": "that model's cap is not enforced as documented: set cap_enforced false in lib/caps.mjs (the live gate then refuses it) and replace it before the pilot"
    },
    "latency": {
      "when": "a model has more than one call time out at 600 s",
      "then": "that model is unsuitable for the pilot as configured: xz decides"
    },
    "identity": {
      "when": "a provider returns a model id whose family differs from the expected family",
      "then": "exclude that model from the pilot until explained"
    },
    "note": "Probe tasks are public calibration tasks, drawn from a seed never used before and excluded from every sealed draw. A verified share here is not a result about inheritance."
  },
  "plan_sha256": "36fe203610e44b620d1cf364fcc434559690951053de6d6bab5bd5ae8bdbf2e4"
