{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "divergence-delta.schema.DRAFT.json",
  "title": "Omnarai Divergence Atlas record (DRAFT schema)",
  "description": "DRAFT — authored 2026-07-14 by deriving the shape of the canonical store (grown-memory blob), because the divergence-delta.schema.json referenced by the handoff package does not exist in the repo (SESSION-LOG.md R2.5). Validation against this draft is real; adopting it as canonical is a curator decision. Escalation rule honored: the store was not modified to fit a schema, the schema was derived from the store.",
  "type": "object",
  "required": [
    "id", "id_series", "dataset_version", "question", "question_group",
    "captured_at", "answers", "tensions", "stale_model_version", "stale_models"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^OMN-[DL]\\d{13}$" },
    "id_series": { "enum": ["D", "L"] },
    "dataset_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "question": { "type": "string", "minLength": 1 },
    "question_group": { "type": "string", "pattern": "^QG-[0-9a-f]{12}$" },
    "captured_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
    "method": { "type": ["string", "null"] },
    "contributors": { "type": "array", "items": { "type": "string" } },
    "answers": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["model", "model_id", "text"],
        "additionalProperties": false,
        "properties": {
          "model": { "type": "string" },
          "lab": { "type": ["string", "null"] },
          "model_id": { "type": "string", "description": "Exact model version string as attested in the store; the literal 'unattested' when absent — never inferred." },
          "date": { "type": ["string", "null"] },
          "text": { "type": "string", "minLength": 1, "description": "Verbatim model output, byte-for-byte." }
        }
      }
    },
    "tensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["voice_a", "claim_a", "voice_b", "claim_b", "topic"],
        "additionalProperties": true,
        "properties": {
          "voice_a": { "type": "string" },
          "claim_a": { "type": "string" },
          "voice_b": { "type": "string" },
          "claim_b": { "type": "string" },
          "topic": { "type": "string" },
          "status": { "type": ["string", "null"] }
        }
      }
    },
    "deliberation_card": {
      "type": ["object", "null"],
      "description": "Engine-side classification at capture time; holdform_risk is an experimental construct (see card Limitations).",
      "additionalProperties": true,
      "properties": {
        "holdform_risk": { "type": ["string", "null"] },
        "holdform_risk_reason": { "type": ["string", "null"] },
        "novel_synthesis": {},
        "epistemic_status": { "type": ["string", "null"] }
      }
    },
    "divergence_score": {
      "type": ["number", "null"],
      "description": "1 − mean pairwise cosine similarity of answer embeddings; null for records captured before scoring existed."
    },
    "certification": {
      "type": ["object", "null"],
      "description": "Perturbation-robustness result (scripts/certify-divergence.mjs, docs/tier3-perturbation-rigor.md); null = never run through the harness.",
      "additionalProperties": true,
      "properties": {
        "tier": { "enum": ["C0", "C1", "C2", "C3"] },
        "method": { "type": "string" },
        "reproducibility": { "type": "string" },
        "runs": { "type": "array" },
        "reconciled_at": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "longitudinal": {
      "type": ["object", "null"],
      "description": "Present on OMN-L records only: the store-attested re-run link.",
      "additionalProperties": true,
      "properties": {
        "canon_id": { "type": "string" },
        "epoch": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
        "source_record": { "type": "string", "pattern": "^OMN-D\\d{13}$" },
        "original_score": { "type": ["number", "null"] }
      }
    },
    "stale_model_version": { "type": "boolean" },
    "stale_models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["model", "model_id", "superseded_by"],
        "properties": {
          "model": { "type": ["string", "null"] },
          "model_id": { "type": "string" },
          "superseded_by": { "type": "string" }
        }
      }
    }
  }
}
