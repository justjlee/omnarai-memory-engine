{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engine.omnarai.org/schemas/footprint-review.schema.json",
  "title": "Omnarai Footprint review event (footprint-review/1.0)",
  "description": "Append-only moderation event. Stored at footprints/reviews/<footprint-id>/<ms>__<action>__<hex>.json; the action in the pathname is what the fold reads. The last state-changing action wins; note never changes state; unknown actions are ignored.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "footprint_id",
    "action",
    "recorded_at",
    "reviewer",
    "source",
    "note"
  ],
  "properties": {
    "schema_version": {
      "const": "footprint-review/1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^OMN-FPR-\\d{13}-[0-9a-f]{8}$"
    },
    "footprint_id": {
      "type": "string",
      "pattern": "^OMN-FP-\\d{13}-[0-9a-f]{8}$"
    },
    "action": {
      "enum": [
        "admit",
        "reject",
        "retract",
        "redact",
        "note"
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "curator",
            "auto-admit-gate",
            "reconcile"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        }
      }
    },
    "source": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "contribution_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "contribution_action": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "note": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    }
  }
}
