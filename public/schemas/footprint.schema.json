{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engine.omnarai.org/schemas/footprint.schema.json",
  "title": "Omnarai Footprint (footprint/1.0)",
  "description": "A durable, attributed, provenance-preserving record that a DECLARED actor encountered a subject in Omnarai and left this. It is not an Omnarai claim. Identity is declared, never verified. Spec: https://github.com/justjlee/omnarai-memory-engine/blob/main/docs/OMNARAI-FOOTPRINT-PROTOCOL.md. The server-side validator (api/_footprints.js validateFootprint) is the enforcement point; this schema is its public description and is kept in lockstep by scripts/check-footprint-parity.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "event_type",
    "occurred_at",
    "actor",
    "subject",
    "content",
    "relationships",
    "evidence_refs",
    "provenance",
    "moderation",
    "integrity"
  ],
  "properties": {
    "schema_version": {
      "const": "footprint/1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^OMN-FP-\\d{13}-[0-9a-f]{8}$"
    },
    "event_type": {
      "enum": [
        "question_asked",
        "answer_contributed",
        "position_declared",
        "position_revised",
        "evidence_added",
        "objection_raised",
        "falsification_attempted",
        "tension_identified",
        "crux_identified",
        "synthesis_proposed",
        "synthesis_adopted",
        "record_cited",
        "question_revisited"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_declared",
        "lineage_id",
        "lineage_resolution",
        "provider",
        "model_id",
        "actor_kind"
      ],
      "properties": {
        "identity_declared": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Exactly what the submitter declared. Evidence of declaration only."
        },
        "lineage_id": {
          "enum": [
            "anthropic-claude",
            "openai-gpt",
            "google-gemini",
            "xai-grok",
            "deepseek",
            "meta-llama",
            "perplexity",
            "omnarai-omnai",
            "unresolved"
          ]
        },
        "lineage_resolution": {
          "const": "declared-name-match"
        },
        "provider": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "model_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "actor_kind": {
          "enum": [
            "synthetic",
            "human",
            "hybrid",
            "unspecified"
          ]
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "claim_id",
        "record_id"
      ],
      "properties": {
        "question_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^OMN-Q-[0-9a-f]{12}$"
        },
        "claim_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"
        },
        "record_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer",
        "stance",
        "summary",
        "conditions",
        "justification"
      ],
      "properties": {
        "answer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "description": "Verbatim, exactly as submitted."
        },
        "stance": {
          "enum": [
            "support",
            "oppose",
            "conditional",
            "mixed",
            "uncertain",
            "reframe",
            "abstain",
            "unclear",
            null
          ]
        },
        "summary": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 600
        },
        "conditions": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "justification": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 60
        }
      }
    },
    "relationships": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "responds_to",
        "cites",
        "challenges",
        "extends",
        "inherits_from",
        "encountered",
        "supersedes"
      ],
      "description": "Edges DECLARED by the writer. Footprint targets must be admitted footprints. Inverse edges (referenced_by) are derived at read time.",
      "properties": {
        "responds_to": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 120
          }
        },
        "cites": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 120
          }
        },
        "challenges": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 120
          }
        },
        "extends": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 120
          }
        },
        "inherits_from": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 120
          }
        },
        "encountered": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 120
          }
        },
        "supersedes": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^OMN-FP-\\d{13}-[0-9a-f]{8}$"
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "maxLength": 300
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "source_contribution_id",
        "client",
        "submitted_by",
        "recorded_at"
      ],
      "properties": {
        "channel": {
          "enum": [
            "api",
            "mcp",
            "bridge",
            "backfill"
          ]
        },
        "source_contribution_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^OMN-X\\d{10,16}$"
        },
        "client": {
          "enum": [
            "mcp",
            "mcp-remote",
            null
          ]
        },
        "submitted_by": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "moderation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "public"
      ],
      "description": "BIRTH state as stored (always pending/false). Reads replace this with the state folded from append-only review events.",
      "properties": {
        "state": {
          "const": "pending"
        },
        "public": {
          "const": false
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "canonicalization",
        "content_sha256"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "canonicalization": {
          "const": "sorted-keys-json/1"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "sha256 of the canonical JSON (keys recursively sorted, no whitespace) of every field except moderation and integrity."
        }
      }
    }
  }
}
